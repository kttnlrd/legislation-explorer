[Unit]
Description=ITAA Legislation Explorer
After=network.target

[Service]
Type=simple
User=harrison
WorkingDirectory=/home/harrison/legislation-explorer
EnvironmentFile=-/home/harrison/legislation-explorer/.env
ExecStart=/home/harrison/legislation-explorer/backend/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8765 --no-server-header
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
